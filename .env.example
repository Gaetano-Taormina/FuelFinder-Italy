# ==============================================================================
# FuelFinder Italy - Environment Variables Configuration
# ==============================================================================

# --- 1. SERVER & NETWORK CONFIGURATION ---
# Port on which the Express server listens (default: 3001)
PORT=3001
SERVER_PORT=3001
# Host address to bind (default: 0.0.0.0 for public/container, 127.0.0.1 for local only)
HOST=0.0.0.0
# Environment mode (development | production | test)
NODE_ENV=development
# Allowed CORS origins (comma-separated or '*' for unrestricted)
CORS_ORIGIN=*
# Gateway timeout for long-running requests in milliseconds (default: 10000)
REQUEST_TIMEOUT_MS=10000

# --- 2. SECURITY & ADMINISTRATION ---
# Admin Security Passkey (used for protected routes: /api/health/recover, /api/stats)
ADMIN_PASSKEY=
# Rate Limiting window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests allowed per IP within the window duration (default: 600)
RATE_LIMIT_MAX=600

# --- 3. DATABASE & STORAGE ---
# Custom data directory for SQLite database storage (default: server/)
DATA_DIR=
# Remote SQLite snapshot URL downloaded from GitHub Releases on startup
DB_DOWNLOAD_URL=https://github.com/Gaetano-Taormina/FuelFinder-Italy/releases/download/latest-data/database.sqlite.gz
# Force database redownload even if local database.sqlite exists (true | false)
FORCE_DB_DOWNLOAD=false

# --- 4. CLOUD & DEPLOYMENT ---
# Render Deploy Hook URL for automated triggering of deployments
RENDER_DEPLOY_HOOK=
# External public URL for heartbeat self-pinging on cloud hosting (e.g. https://fuelfinder.onrender.com)
RENDER_EXTERNAL_URL=
# Enable heartbeat self-ping interval (true | false)
ENABLE_HEARTBEAT=false

# --- 5. OPERATIONAL MODES ---
# Maintenance Mode: when 'true', all incoming requests receive an SEO-friendly 503 Service Unavailable
MAINTENANCE_MODE=false

# --- 6. FRONTEND (Vite / Client) ---
# Port on which the Vite development server runs (default: 5173)
CLIENT_PORT=5173
# Base API URL used by the client for REST requests (leave blank for same-origin /api proxy)
VITE_API_BASE_URL=
# Application display title
VITE_APP_TITLE=FuelFinder Italy
