# Admin Security Passkey
ADMIN_PASSKEY=

# Option A: Standalone SQLite with Automated Startup Download (Recommended for Render)
# Set DB_DOWNLOAD_URL to your GitHub Release asset URL:
# e.g. https://github.com/<owner>/FuelFinder-Italy/releases/download/latest-data/database.sqlite.gz
DB_DOWNLOAD_URL=
FORCE_DB_DOWNLOAD=false
# Optional custom data directory (defaults to 'server' folder or /tmp)
# DATA_DIR=/tmp

# Option B: Cloud Database (Turso libSQL) - Optional
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_PLATFORM_API_TOKEN=
TURSO_ORG_SLUG=

# Optional Deploy Hook
RENDER_DEPLOY_HOOK=
