{
  "name": "fuelfinder-italy",
  "private": true,
  "version": "1.1.0",
  "description": "Trova i distributori di carburante più economici in Italia",
  "keywords": [
    "carburante",
    "prezzi",
    "mappa",
    "italia",
    "benzina",
    "diesel",
    "fuel",
    "italy"
  ],
  "author": "FuelFinder",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host\" \"node server/server.js\"",
    "start": "node server/server.js",
    "sync": "node -e \"import('./server/sync.js').then(m => m.sync())\"",
    "build": "vite build",
    "preview": "vite preview",
    "stats": "node server/stats-cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.2",
    "swr": "^2.5.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.11.6",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11"
  }
}
