{
  "name": "fuelfinder-italy",
  "private": true,
  "version": "1.2.4",
  "description": "Trova i distributori di carburante più economici in Italia",
  "keywords": [
    "carburante",
    "prezzi-carburanti",
    "prezzo-benzina",
    "distributori-italia",
    "benzina",
    "diesel",
    "gasolio",
    "gpl",
    "metano",
    "hvo",
    "pompe-bianche",
    "mimit-open-data",
    "mappa-interattiva",
    "fuel-prices-italy",
    "gas-stations"
  ],
  "author": "FuelFinder",
  "license": "MIT",
  "homepage": "https://github.com/Gaetano-Taormina/FuelFinder-Italy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaetano-Taormina/FuelFinder-Italy.git"
  },
  "bugs": {
    "url": "https://github.com/Gaetano-Taormina/FuelFinder-Italy/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"vite,api\" -c \"cyan.bold,green.bold\" \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host",
    "dev:server": "node --watch server/server.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --emptyOutDir",
    "preview": "vite preview",
    "start": "node server/server.js",
    "sync": "node server/sync-cli.js",
    "stats": "node server/stats-cli.js",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint --fix -c .oxlintrc.json",
    "test": "node scripts/test-runner.js all",
    "test:coverage": "node scripts/test-runner.js coverage",
    "release": "node scripts/release.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "lint-staged": {
    "*.{js,jsx}": "oxlint -c .oxlintrc.json"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.3",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.81.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.0"
  }
}
