{
  "name": "fuelfinder-italy",
  "private": true,
  "version": "1.6.0",
  "description": "Trova i distributori di carburante più economici in Italia (Workspace Decoupled Architecture)",
  "keywords": [
    "carburante",
    "prezzi-carburanti",
    "prezzo-benzina",
    "distributori-italia",
    "benzina",
    "diesel",
    "gasolio",
    "gpl",
    "metano",
    "hvo",
    "pompe-bianche",
    "mimit-open-data",
    "mappa-interattiva",
    "fuel-prices-italy",
    "gas-stations"
  ],
  "author": "FuelFinder",
  "license": "MIT",
  "homepage": "https://github.com/Gaetano-Taormina/FuelFinder-Italy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaetano-Taormina/FuelFinder-Italy.git"
  },
  "bugs": {
    "url": "https://github.com/Gaetano-Taormina/FuelFinder-Italy/issues"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/kill-dev-ports.js",
    "dev": "concurrently -k -n \"client,server\" -c \"cyan.bold,green.bold\" \"pnpm --filter client dev\" \"pnpm --filter server dev\"",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build",
    "preview": "pnpm --filter client preview",
    "start": "pnpm --filter server start",
    "sync": "pnpm --filter server sync",
    "stats": "pnpm --filter server stats",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint --fix -c .oxlintrc.json",
    "security": "node scripts/security-audit.js",
    "audit": "node scripts/security-audit.js",
    "test": "node scripts/test-runner.js all",
    "test:coverage": "node scripts/test-runner.js coverage",
    "release": "node scripts/release.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "overrides": {
    "undici": ">=8.10.2"
  },
  "lint-staged": {
    "*.{js,jsx}": "oxlint -c .oxlintrc.json"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.85.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.4",
    "supertest": "^7.3.0",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.2"
  }
}
