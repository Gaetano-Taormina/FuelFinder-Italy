{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*", "src/*"]
    },
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "client/src/**/*",
    "server/**/*",
    "tests/**/*",
    "client/vite.config.js",
    "vitest.config.js"
  ]
}
