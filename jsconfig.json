{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*"]
    },
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "client/src/**/*",
    "server/**/*",
    "tests/**/*",
    "scripts/**/*",
    "client/vite.config.js",
    "vitest.config.js",
    "playwright.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client/dist",
    "coverage"
  ]
}
